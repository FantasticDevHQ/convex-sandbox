# No provider or identity key is needed for the managed local simulator.
# worktree:start --frontend supplies this checkout's allocated Convex URL.
# For a standalone frontend connected to that same local backend only:
# VITE_CONVEX_URL=http://127.0.0.1:YOUR_ALLOCATED_CLOUD_PORT

# Only after separate authorization, use an existing Clerk development instance:
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_EXISTING_DEVELOPMENT_INSTANCE

# BOAT_API_KEY, BOAT_ORG, CLERK_JWT_ISSUER_DOMAIN, EXAMPLE_OPERATOR_GRANTS
# and EXAMPLE_LIVE_RUN_PLAN belong only on the exact owned backend.
# Never put provider keys, secret keys or operator policy in VITE_* variables.
# See docs/example-walkthrough.md and docs/example-auth.md.
