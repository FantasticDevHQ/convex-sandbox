# Optional for future backend-connected UI work. Not needed by the starter.
# VITE_CONVEX_URL=http://127.0.0.1:YOUR_ALLOCATED_CLOUD_PORT

# Optional Clerk development publishable key, never a secret key.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_EXISTING_DEVELOPMENT_INSTANCE
# Configure CLERK_JWT_ISSUER_DOMAIN and EXAMPLE_OPERATOR_GRANTS on the owned
# local Convex backend, not in VITE_* variables. See docs/example-auth.md.
